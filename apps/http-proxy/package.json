{
  "name": "@deepseek-ai/dsh-http-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP/SSE proxy — bridges iOS client to a local dsh-jsonrpc-agent subprocess over Tailscale",
